n%3DBorderReport%26pers_cid%3Dunknown%26bob_ck%3D[bob_ck_val]%26d_code%3D1%26pagetype%3D%26aa%3Df&amp;vid=12140579&amp;cmsid=11111&quot;}\"> </video> \n\t\t\t<div class=\"video-float-bar\">\n\t\t\t\t<h4 class=\"video-float-title\"> </h4>\n\t\t\t\t<button class=\"video-float-close\"></button>\n\t\t\t</div>\n\t\t\t<div class=\"video-float-touch-area\">\n\t\t\t\t<span class=\"video-float-minimized-status\">\n\t\t\t\t\tNOW PLAYING\n\t\t\t\t</span>\n\t\t\t\t<h4 class=\"video-float-minimized-title\"> </h4>\n\t\t\t\t<button class=\"video-float-mobile-expand-button\"></button>\n\t\t\t</div>\n\t\t</div> </div>\n\n\n<p>A separate video obtained by Border Report shows two people near a drainage opening in the Downtown El Paso and Segundo Barrio area. Second Baptist Church, at 401 S. Virginia St., appears in the background.</p>\n\n\n\n<p>Border Report has not confirmed where the over 8 people came from or whether that drainage system connects to any known cross-border tunnel. The video, however, shows how close some underground infrastructure sits to El Paso neighborhoods, businesses and churches and how easy is for the smugglers to use them.</p>\n\n\n<div class=\"wp-block-nexstar-video\"> <div id=\"story-embed-2\" class=\"nexstar-video\" data-player-location=\"Story Embed\"    > <video id=\"nxsplayer_6115607d82\" class=\"video-js vjs-nexstar-skin\" data-nexstar-video=\"{&quot;id&quot;:&quot;12140590&quot;,&quot;provider&quot;:&quot;anvato&quot;,&quot;attributes&quot;:{&quot;id&quot;:&quot;12140590&quot;,&quot;type&quot;:&quot;video&quot;,&quot;provider&quot;:&quot;anvato&quot;,&quot;station&quot;:&quot;kxan&quot;,&quot;playlistId&quot;:&quot;&quot;,&quot;preRoll&quot;:true,&quot;autoplay&quot;:false,&quot;title&quot;:&quot;Manhole VO&quot;,&quot;titleVisible&quot;:true,&quot;isEmbed&quot;:false,&quot;allowEmbedInPlayer&quot;:true,&quot;adTagUrl&quot;:&quot;&quot;,&quot;recommendations&quot;:false,&quot;player&quot;:&quot;&quot;,&quot;has_auth&quot;:false,&quot;floating_enabled&quot;:null,&quot;player_location&quot;:&quot;Story Embed&quot;},&quot;autoplay&quot;:false,&quot;pluginConfig&quot;:{&quot;share&quot;:{&quot;enabled&quot;:true,&quot;url&quot;:&quot;https:\\/\\/www.borderreport.com\\/video\\/manhole-vo\\/12140590&quot;,&quot;embedCode&quot;:&quot;&lt;iframe id=\\&quot;nxs-video-iframe-2\\&quot; frameborder=\\&quot;0\\&quot; allowfullscreen loading=\\&quot;lazy\\&quot; style=\\&quot;width: 100%; height: auto; aspect-ratio: 16\\/9; \\&quot; src=\\&quot;https:\\/\\/redir1.borderreport.com\\/nxs-video\\/vid-anvato-12140590\\/embed\\/?injected_via=embed&#038;post_id=3078323\\&quot; rel=\\&quot;nofollow\\&quot; width=\\&quot;640\\&quot; height=\\&quot;320\\&quot;&gt;&lt;\\/iframe&gt;&quot;,&quot;socials&quot;:[&quot;fbFeed&quot;,&quot;tw&quot;,&quot;email&quot;]},&quot;nielsen&quot;:{&quot;enabled&quot;:true,&quot;id&quot;:&quot;12140590&quot;,&quot;title&quot;:&quot;Manhole VO&quot;,&quot;airdate&quot;:&quot;1788561000&quot;,&quot;program&quot;:&quot;Border Report&quot;,&quot;isLivestream&quot;:false,&quot;type&quot;:&quot;dcr&quot;,&quot;appId&quot;:&quot;&quot;,&quot;sfcode&quot;:&quot;&quot;,&quot;apn&quot;:&quot;&quot;,&quot;environment&quot;:&quot;production&quot;,&quot;useDerivedMetadata&quot;:true,&quot;mapping&quot;:{&quot;adloadtype&quot;:2,&quot;adModel&quot;:2},&quot;id3Enabled&quot;:false,&quot;isAdsDisabled&quot;:true},&quot;ads&quot;:{&quot;enabled&quot;:true,&quot;adTagUrl&quot;:&quot;&quot;,&quot;contribAdsTimeout&quot;:&quot;5000&quot;,&quot;contribAdsPrerollTimeout&quot;:&quot;5000&quot;,&quot;contribAdsPostrollTimeout&quot;:&quot;5000&quot;,&quot;isFreewheel&quot;:false},&quot;playerMetadata&quot;:{&quot;enabled&quot;:true,&quot;metadata&quot;:{&quot;enabled&quot;:true,&quot;autoplay&quot;:false,&quot;injectedVia&quot;:&quot;&quot;,&quot;playerLocation&quot;:&quot;Story Embed&quot;,&quot;isLeadMedia&quot;:false,&quot;isEmbedVideoInPost&quot;:false,&quot;isFloatingEnabled&quot;:false}},&quot;events&quot;:{&quot;enabled&quot;:true,&quot;contentType&quot;:&quot;video&quot;},&quot;videoInitType&quot;:{&quot;enabled&quot;:true},&quot;qualitySelector&quot;:{&quot;enabled&quot;:true},&quot;heartbeat&quot;:{&quot;enabled&quot;:true},&quot;networkRecovery&quot;:{&quot;enabled&quot;:true},&quot;contentMetadata&quot;:{&quot;enabled&quot;:true,&quot;videos&quot;:{&quot;12140590&quot;:{&quot;videoId&quot;:&quot;12140590&quot;,&quot;videoTitle&quot;:&quot;Manhole VO&quot;,&quot;program&quot;:&quot;Border Report&quot;,&quot;fullEpisode&quot;:true,&quot;framerate&quot;:30,&quot;airDate&quot;:&quot;1788561000&quot;,&quot;videoDuration&quot;:33,&quot;originalVideoTitle&quot;:&quot;Manhole VO&quot;}}},&quot;videoTitle&quot;:{&quot;enabled&quot;:true,&quot;title&quot;:&quot;Manhole VO&quot;,&quot;align&quot;:&quot;top-left&quot;,&quot;titleVisible&quot;:true},&quot;comscore&quot;:{&quot;enabled&quot;:true,&quot;COMSCORE_PUBLISHER_ID&quot;:6036439,&quot;id&quot;:&quot;12140590&quot;,&quot;title&quot;:&quot;Manhole VO&quot;,&quot;videoType&quot;:&quot;vod&quot;,&quot;callSign&quot;:&quot;kxan&quot;,&quot;domainName&quot;:&quot;borderreport.com&quot;,&quot;videoDuration&quot;:33,&quot;programName&quot;:&quot;Border Report&quot;}},&quot;recommendations&quot;:false,&quot;tve_enabled&quot;:false,&quot;livestreams&quot;:[],&quot;contentMetadata&quot;:{&quot;12140590&quot;:{&quot;videoId&quot;:&quot;12140590&quot;,&quot;videoTitle&quot;:&quot;Manhole VO&quot;,&quot;program&quot;:&quot;Border Report&quot;,&quot;fullEpisode&quot;:true,&quot;framerate&quot;:30,&quot;airDate&quot;:&quot;1788561000&quot;,&quot;videoDuration&quot;:33,&quot;originalVideoTitle&quot;:&quot;Manhole VO&quot;}},&quot;poster&quot;:&quot;https:\\/\\/h104216-dcdn.mp.lura.live\\/1\\/938825\\/pvw_lin\\/B87\\/32D\\/B8732DF6E659EFB20BEF893FF8C5E0D8_3.jpg?aktaexp=2082787200&amp;aktasgn=12c15fbcbc39e33c7be309456f1e9073&quot;,&quot;sources&quot;:[{&quot;src&quot;:&quot;https:\\/\\/tkx.mp.lura.live\\/rest\\/v2\\/mcp\\/video\\/12140590.m3u8?anvack=Rawk5AaXamlYMHRoV0UeKfkdB3KQ0dnD&amp;eud=NExlctJX0MT7X8mwrM3XdzqUHVjPM0Frsq9TRUEb4ak%2FKJgRKZ%2B64LxwkKEbw%2B0YTyO8KsbFw40vgX8hrw%2Bxqw%3D%3D&quot;,&quot;videoType&quot;:&quot;video&quot;,&quot;renderMethod&quot;:&quot;static&quot;}],&quot;title&quot;:&quot;Manhole VO&quot;,&quot;error&quot;:null,&quot;playerId&quot;:&quot;nxsplayer_6115607d82&quot;,&quot;adTagUrl&quot;:&quot;https:\\/\\/pubads.g.doubleclick.net\\/gampad\\/ads?sz=1x1000&amp;iu=\\/5678\\/nx.border&amp;impl=s&amp;gdfp_req=1&amp;env=vp&amp;output=vmap&amp;unviewed_position_start=1&amp;ad_rule=1&amp;description_url=&amp;cust_params=station%3DBorderReport%26pers_cid%3Dunknown%26bob_ck%3D[bob_ck_val]%26d_code%3D1%26pagetype%3D%26aa%3Df&amp;vid=12140590&amp;cmsid=11111&quot;}\"> </video> \n\t\t\t<div class=\"video-float-bar\">\n\t\t\t\t<h4 class=\"video-float-title\"> </h4>\n\t\t\t\t<button class=\"video-float-close\"></button>\n\t\t\t</div>\n\t\t\t<div class=\"video-float-touch-area\">\n\t\t\t\t<span class=\"video-float-minimized-status\">\n\t\t\t\t\tNOW PLAYING\n\t\t\t\t</span>\n\t\t\t\t<h4 class=\"video-float-minimized-title\"> </h4>\n\t\t\t\t<button class=\"video-float-mobile-expand-button\"></button>\n\t\t\t</div>\n\t\t</div> </div>\n\n\n<p>The footage comes as federal prosecutors announced a guilty plea in a major human-smuggling case involving a sophisticated tunnel that connected Ciudad Juárez with El Paso.</p>\n\n\n\n<h3 class=\"wp-block-heading\">Smugglers charged migrants up to $30,000</h3>\n\n\n\n<p>Luis Carlos Davalos-Lopez, 29, of Mexico, pleaded guilty in El Paso to conspiracy to bring migrants into the United States, according to the Justice Department.</p>\n\n\n\n<p>Prosecutors say Davalos-Lopez worked with others to move migrants from Ciudad Juárez into El Paso through an underground tunnel.</p>\n\n\n\n<p>Federal agents found the sophisticated cross-border tunnel in January 2025.</p>\n\n\n\n<p>Investigators intercepted phone calls in which Davalos-Lopez and others discussed moving migrants through the tunnel and charging them as much as $30,000 per person, according to the Justice Department. The conversations also included discussions about how many migrants used the tunnel.</p>\n\n\n\n<p>The FBI says the Cartel de Jalisco Nueva Generación, or CJNG, constructed the tunnel to support criminal operations involving human smuggling, drugs, and firearms.</p>\n\n\n\n<p>“Davalos-Lopez and his co-conspirators thought they could exploit the United States southern border utilizing a secret tunnel,” FBI El Paso Acting Special Agent in Charge Coult W. Markovsky said in the Justice Department release.</p>\n\n\n\n<p>Davalos-Lopez pleaded guilty to one count of conspiracy to bring migrants into the United States. He faces up to 10 years in federal prison. A judge has not yet set his sentencing date.</p>\n\n\n\n<h3 class=\"wp-block-heading\">Investigation also uncovered gun trafficking</h3>\n\n\n\n<p>Federal investigators say the organization moved more than people across the border.</p>\n\n\n\n<p>U.S. Attorney Justin R. Simmons said members of the criminal enterprise smuggled drugs and migrants into the United States while trafficking firearms from the United States into Mexico.</p>\n\n\n\n<p>Davalos-Lopez’s co-defendant, Maria Del Rosario Navarro-Sanchez, 40, previously pleaded guilty to conspiring to provide material support to CJNG by trafficking firearms from the United States to Mexico.</p>\n\n\n\n<p>Another defendant, Gustavo Castro-Medina, 29, previously pleaded guilty to helping transfer $3,000 to an undercover agent to purchase firearms for illegal transport, according to prosecutors.</p>\n\n\n\n<p>The FBI, the Bureau of Alcohol, Tobacco, Firearms and Explosives, the Drug Enforcement Administration, and Homeland Security Investigations investigated the case. U.S. Border Patrol and Mexican authorities also assisted.</p>\n\n\n\n<h3 class=\"wp-block-heading\">Underground routes remain a challenge</h3>\n\n\n\n<p>The new Border Patrol footage underscores a problem that extends beyond a single tunnel.</p>\n\n\n\n<p>In the video, migrants appear to be heavily coated in wet mud after traveling through an underground route.</p>\n\n\n\n<p>In the separate video recorded near South Virginia Street, two people stand near a drainage opening only blocks from Downtown El Paso, with Second Baptist Church visible nearby.</p>\n\n\n\n<p>The videos do not establish a connection between that drainage opening and the tunnel in the Davalos-Lopez prosecution.</p>\n\n\n\n<p>Instead, they illustrate how smugglers can exploit underground infrastructure along a densely populated stretch of the U.S.-Mexico border.</p>\n\n\n\n<p>The Davalos-Lopez investigation provides one example of the money involved. Prosecutors say smugglers discussed charging migrants as much as $30,000 to use the tunnel between Juárez and El Paso.</p>\n\n\n\n<p>Federal prosecutors pursued the case through Joint Task Force Alpha, a Justice Department initiative that targets major human-smuggling and trafficking organizations. The Justice Department says the task force has helped secure more than 482 arrests and 433 U.S. convictions.</p>\n\n\n\n<p>For Border Patrol and other federal agencies, the latest video highlights an enforcement challenge that fences and barriers alone cannot address: smugglers continue searching for ways to move people under the border.</p>\n\n\n\n<p><em>Aracely Lazcano can be reached at alazcano@borderreport.com</em></p>\n\n\n\n<p></p>\n",
