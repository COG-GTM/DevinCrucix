# ============================================
# Crucix Intelligence Engine — Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# Keys are optional — sources without keys degrade gracefully.
#
# IMPORTANT: Do NOT put comments on the same line as values.
# Docker env_file treats inline comments as part of the value.

# === OSINT Source API Keys ===

# Federal Reserve Economic Data (free: fred.stlouisfed.org/docs/api)
FRED_API_KEY=
# NASA FIRMS fire data (free: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# Energy Information Administration (free: api.eia.gov/register)
EIA_API_KEY=
# Maritime AIS data (aisstream.io)
AISSTREAM_API_KEY=
# Armed Conflict Location & Event Data (acleddata.com/user/register)
ACLED_EMAIL=
# OAuth2 password grant (API keys deprecated Sept 2025)
ACLED_PASSWORD=
# Cloudflare Radar internet outages & traffic anomalies (free: dash.cloudflare.com/profile/api-tokens, Account Analytics Read)
CLOUDFLARE_API_TOKEN=

# Singapore Land Transport Authority — CCTV mesh (free: datamall.lta.gov.sg/content/datamall/en/request-for-api.html)
LTA_API_KEY=

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes) — full 38-source sweep
REFRESH_INTERVAL_MINUTES=15
# Market data fast-refresh interval (seconds) — YFinance prices only
MARKET_REFRESH_SECONDS=60

# === Border Watch Ingestion (Python service, ingest/) ===
# Where the Node dashboard reads Border Watch data from. Docker Compose overrides this to http://ingest:3118.
INGEST_API_URL=http://127.0.0.1:3118
# Bind address/port of the Python JSON API. Keep it on loopback unless a reverse proxy fronts it.
INGEST_API_HOST=127.0.0.1
INGEST_API_PORT=3118
# Feed polling interval (minutes) and per-host politeness delay (seconds)
INGEST_POLL_INTERVAL_MINUTES=15
INGEST_PER_HOST_DELAY_SECONDS=2
# How often the structured-baseline schedules (monthly/weekly/quarterly) are re-evaluated (minutes)
INGEST_BASELINE_CHECK_INTERVAL_MINUTES=360
# SQLite database and raw-HTML snapshot directory (default: runs/ingest/)
INGEST_DB_PATH=
INGEST_SNAPSHOT_DIR=
# Multilingual NER (spaCy). Set INGEST_NER_ENABLED=0 to skip entity extraction.
INGEST_NER_ENABLED=1
INGEST_NER_MODEL=xx_ent_wiki_sm
# Machine translation of Spanish text into a derived field: none | libretranslate | openai_compatible
INGEST_TRANSLATION_PROVIDER=none
INGEST_LIBRETRANSLATE_URL=
INGEST_LIBRETRANSLATE_API_KEY=
# openai_compatible falls back to LLM_API_KEY / LLM_MODEL when these are blank
INGEST_TRANSLATION_API_BASE=
INGEST_TRANSLATION_API_KEY=
INGEST_TRANSLATION_MODEL=
# News-reporting anomaly detector: weeks of history, z-score threshold, minimum stories in the window
INGEST_ANOMALY_BASELINE_WEEKS=8
INGEST_ANOMALY_Z_THRESHOLD=2.5
INGEST_ANOMALY_MIN_COUNT=3
# Optional manually downloaded ACLED export (one-time snapshot, never polled)
INGEST_ACLED_SNAPSHOT_PATH=
# Optional local CBP CSV directory (skips the live portal fetch)
INGEST_CBP_LOCAL_PATH=
# Hosts allowed for official dataset downloads whose platform robots.txt is a blanket Disallow (comma-separated; blank disables)
INGEST_DATASET_DOWNLOAD_HOSTS=sspcgob-my.sharepoint.com
# Structured JSON logs (1) or plain text (0)
INGEST_LOG_JSON=1

# === LLM Layer (optional) ===
# Enables AI-enhanced trade ideas and breaking news Telegram alerts.
# Provider options: anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama | grok
LLM_PROVIDER=
# Not needed for codex (uses ~/.codex/auth.json) or ollama (local)
LLM_API_KEY=
# Optional override. Each provider has a sensible default:
# anthropic: claude-sonnet-4-6 | openai: gpt-5.4 | gemini: gemini-3.1-pro | codex: gpt-5.3-codex | openrouter: openrouter/auto | minimax: MiniMax-M2.5 | ollama: llama3.1:8b | grok: grok-4-latest
LLM_MODEL=
# Ollama base URL (only needed if not using default http://localhost:11434)
OLLAMA_BASE_URL=

# === Phase 4: AI Summarization Chain (optional) ===
# Groq cloud inference (free tier: console.groq.com)
GROQ_API_KEY=
# OpenRouter multi-model fallback (openrouter.ai/keys)
OPENROUTER_API_KEY=
# Ollama model override (auto-discovers if not set; OLLAMA_BASE_URL is in LLM Layer above)
# OLLAMA_MODEL=

# === Phase 5: Feature Configuration ===

# Pentagon Pizza Index — DOUGHCON alert threshold (1-5, lower = more critical)
PIZZA_ALERT_THRESHOLD=2

# Telegram OSINT — default channels (comma-separated)
TELEGRAM_OSINT_CHANNELS=ConflictsTracker,OSINTWarfare,monitor_the_situation,inaboringworld

# === Telegram Alerts (optional, requires LLM) ===
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
